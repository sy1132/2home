@model _2home.ViewModels.User

@{
    ViewBag.Title = "Settings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<head>
    <link href="~/asset/css/login.css" rel="stylesheet" />
    <script>
        function validatePasswords() {
            var password1 = document.getElementById("password1").value;
            var password2 = document.getElementById("password2").value;

            if (password1 !== password2) {
                document.getElementById("passwordError").innerText = "Mật khẩu mới và mật khẩu xác nhận không khớp.";
                return false;
            } else {
                document.getElementById("passwordError").innerText = "";
            }
            return true;
        }
    </script>
</head>

<form method="post" action="@Url.Action("UpdateSettings", "Home")" onsubmit="return validatePasswords();">
    <div class="card mx-auto shadow-lg p-3 m-5 bg-white rounded" style="width: 50rem;">
        <h2 class="card-title text-center mb-4">Chào mừng bạn đến tới website Second Home</h2>
        <h2 class="card-title text-center mb-4">Cài đặt tài khoản</h2>

        @if (ViewBag.Message != null)
        {
            <div class="alert alert-success">@ViewBag.Message</div>
        }

        <div class="col-md-12 mb-3">
            <label for="fullname" class="form-label">Họ và tên</label>
            <div class="input-group">
                <input type="text" class="form-control" id="fullname" name="fullname" value="@Model.fullname"  />
            </div>
        </div>

        <div class="col-md-12 mb-3">
            <label for="email" class="form-label">Email</label>
            <div class="input-group">
                <input type="email" class="form-control" id="email" name="email" value="@Model.Email"  />
            </div>
        </div>

        <div class="col-md-12 mb-3">
            <label for="phone" class="form-label">Số điện thoại</label>
            <div class="input-group">
                <input type="text" class="form-control" id="phone" name="PhoneNumber" value="@Model.PhoneNumber"  />
            </div>
        </div>

        <div class="col-md-12 mb-3">
            <label for="gender" class="form-label">Giới tính</label>
            <div class="input-group">
                <select class="form-select" id="gender" name="gender">
                    <option value="Nam" @(Model.gender == "Nam" ? "selected" : "")>Nam</option>
                    <option value="Nữ" @(Model.gender == "Nữ" ? "selected" : "")>Nữ</option>
                </select>
            </div>
        </div>

        <div class="col-md-12 mb-3">
            <label for="password" class="form-label">Mật khẩu cũ</label>
            <div class="input-group">
                <input type="password" class="form-control" id="password" name="password" />
                @if (ViewBag.PasswordError != null)
                {
                    <div class="text-danger">@ViewBag.PasswordError</div>
                }
            </div>
        </div>

        <div class="col-md-12 mb-3">
            <label for="password1" class="form-label">Mật khẩu mới</label>
            <div class="input-group">
                <input type="password" class="form-control" id="password1" name="password1" />
            </div>
        </div>

        <div class="col-md-12 mb-3">
            <label for="password2" class="form-label">Nhập lại mật khẩu</label>
            <div class="input-group">
                <input type="password" class="form-control" id="password2" name="password2" />
            </div>
            <div id="passwordError" class="text-danger mt-1"></div>
        </div>

        <div class="text-center mb-4">
            <button type="submit" class="btn btn-primary">Cập nhật</button>
        </div>
    </div>
</form>
