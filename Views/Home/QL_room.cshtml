@model PagedList.IPagedList<_2home.ViewModels.room>
@using PagedList.Mvc;
@{
    ViewBag.Title = "QL_room";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<head>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
</head>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Người thuê trọ</th>
            <th>Ngày cập nhật</th>
            <th>Tổng tiền điện</th>
            <th>Tổng tiền nước</th>
            <th>Chi phí phát sinh</th>
            <th>Tiền phòng</th>
            <th>Tổng tiền phòng</th>
            <th>Tổng tiền</th>
            <th>Tình Trạng</th>
            <th>Hành động</th> 
        </tr>
    </thead>
    <tbody>
        @foreach (var items in Model)
        {
            <tr>
                <td>
                    @if (string.IsNullOrEmpty(items.fullname))
                    {
                        @($"{items.Motel_ID}r{items.Room_ID}")
                    }
                    else
                    {
                        @items.fullname
                    }
                </td>
                <td>@items.Date_of_Issue</td>
                <td>@String.Format("{0:0,0}", items.Electricity_Bill) VNĐ</td>
                <td>@String.Format("{0:0,0}", items.Water_Bill) VNĐ</td>

                <td>@String.Format("{0:0,0}", items.Additional_Charges) VNĐ</td>
                <td>@String.Format("{0:0,0}", items.Price) VNĐ</td>
                <td>@String.Format("{0:0,0}", items.Latest_Total_Amount_Due) VNĐ</td>
                <td>@String.Format("{0:0,0}", items.Total_Amount_Due) VNĐ</td>

                <td>@items.Room_Status</td>
                <td>
                    @using (Html.BeginForm("rent_checkin", "Home", FormMethod.Get))
                    {
                        @Html.Hidden("ID_User", items.ID_User)
                        <input type="submit" value="Xem chi tiết" class="btn btn-primary" />
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="pagination-container">
    @Html.PagedListPager(Model, page => Url.Action("QL_room", new { page }), PagedListRenderOptions.Classic)
</div>
