
@model PagedList.IPagedList<_2home.ViewModels.room>
@using PagedList.Mvc;
@{
    ViewBag.Title = "QL_room";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<head>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
</head>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Mã phòng trọ</th>
            <th>Người thuê trọ</th>
            <th>Ngày cập nhật</th>
            <th>Tổng tiền điện</th>
            <th>Tổng tiền nước</th>
            <th>Chi phí phát sinh</th>
            <th>Tổng tiền </th>
            <th>Tình Trạng</th>
            <th>Chi Tiết</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var items in Model)
        {
            <tr>
                <td>@items.Room_ID</td>
                <td>@items.fullname</td>
                <td>@items.Date_of_Issue</td> 
                <td>@items.Electricity_Bill</td>
                <td>@items.Water_Bill</td>
                <td>@items.Additional_Charges</td>
                <td>@items.Total_Amount_Due</td>
                <td>@items.Room_Status</td>
                <td>
                    <a href="@Url.Action("ChiTietPhong", "Phong", new { id = items.Room_ID })" class="btn btn-info">Xem Chi Tiết</a>
                </td>
            </tr>
        }

    </tbody>
</table>

<div class="pagination-container">
    @Html.PagedListPager(Model, page => Url.Action("rental_management", new { page }), PagedListRenderOptions.Classic)
</div>
