

@model PagedList.IPagedList<_2home.ViewModels.index_Viewmodel>
@using PagedList.Mvc;
@{
    ViewBag.Title = "QL_room";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<head>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
</head>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Mã phòng trọ</th>
            <th>Người thuê trọ</th>
            <th>Ngày cập nhật</th>
            <th>Số điện</th>
            <th>Số nước</th>
            <th>Tiền điện</th>
            <th>Tiền nước</th>
            <th>Tổng tiền điện</th>
            <th>Tổng tiền nước</th>
            <th>Chi phí phát sinh</th>
            <th>Tình Trạng</th>
            <th>Tổng tiền </th>
            <th>Tình Trạng</th>
            <th>Chi Tiết</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var items in Model)
        {
            <tr>
                
                <td></td>
                <td>@items.Location</td>
                <td>@items.Price</td>
                <td>
                    @using (Html.BeginForm("UpdateAvailability", "Home", FormMethod.Post))
                    {
                        @Html.Hidden("ID_user", items.ID_user)
                        <select name="is_available" onchange="this.form.submit()">
                            <option value="Còn trống" @(items.is_available == "Còn trống" ? "selected" : "")>Còn trống</option>
                            <option value="Hết phòng" @(items.is_available == "Hết phòng" ? "selected" : "")>Hết phòng</option>
                            <option value="Đang chờ duyệt" @(items.is_available == "Đang chờ duyệt" ? "selected" : "")>Đang chờ duyệt</option>
                        </select>
                    }
                </td>
                <td>
                    @using (Html.BeginForm("Details", "Home", FormMethod.Get))
                    {
                        @Html.Hidden("ID_user", items.ID_user)
                        <input type="submit" value="Xem chi tiết" class="btn btn-primary" />
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="pagination-container">
    @Html.PagedListPager(Model, page => Url.Action("rental_management", new { page }), PagedListRenderOptions.Classic)
</div>
