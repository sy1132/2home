@model PagedList.IPagedList<_2home.ViewModels.index_Viewmodel>
@using PagedList.Mvc;
@{
    ViewBag.Title = "KiemduyetInkeeper";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<head>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <script>
        function toggleReasonField(motelId) {
            var reasonField = document.getElementById("reasonField_" + motelId);
            if (reasonField.style.display === "none") {
                reasonField.style.display = "block";
            } else {
                reasonField.style.display = "none";
            }
        }
    </script>
</head>

<div class="container mt-4">
    <h2 class="text-center">Danh Sách đơn xin ở chung</h2>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Tên nhà trọ</th>
                <th>Vị Trí</th>
                <th>Giá</th>
                <th>Chi Tiết Phòng</th>
                <th>Chi Tiết Yêu Cầu</th>
                <th>Hành Động</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.MotelName</td>
                    <td>@item.Location</td>
                    <td>@item.Price</td>
                    <td>@item.roomdetails</td>
                    <td>@item.requestdetails</td>
                    <td>
                        <div class="btn-group">
                            @using (Html.BeginForm("Accepti", "Home", FormMethod.Post))
                            {
                                @Html.Hidden("Motel_ID", item.Motel_ID)
                                @Html.Hidden("room_ID", item.room_ID)
                                @Html.Hidden("together_ID", item.together_ID)
                                <input type="submit" value="Đồng ý" class="btn btn-success" />
                            }
                            <input type="button" value="Từ chối" class="btn btn-danger" onclick="toggleReasonField('@item.Motel_ID')" />
                        </div>
                        <div id="reasonField_@item.Motel_ID" style="display: none; margin-top: 10px;">
                            @using (Html.BeginForm("Rejecti", "Home", FormMethod.Post))
                            {
                                @Html.Hidden("Motel_ID", item.Motel_ID)
                                @Html.Hidden("room_ID", item.room_ID)
                                @Html.Hidden("together_ID", item.together_ID)
                                <label for="reasonInput_@item.Motel_ID">Lý do từ chối:</label>
                                <textarea id="reasonInput_@item.Motel_ID" name="Reason" class="form-control" rows="2" required></textarea>
                                <br />
                                <input type="submit" value="Gửi lý do" class="btn btn-primary" />
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="pagination-container">
        @Html.PagedListPager(Model, page => Url.Action("Kiemduyet", new { page }), PagedListRenderOptions.Classic)
    </div>
</div>
