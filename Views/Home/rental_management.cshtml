@model PagedList.IPagedList<_2home.ViewModels.index_Viewmodel>
@using PagedList.Mvc;
@{
    ViewBag.Title = "rental_management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<head>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
</head>
<form method="get" action="@Url.Action("rental_management")" class="form-inline">
    <div class="form-group mx-sm-3 mb-2">
        <label for="fullname" class="mr-2">Tên nhà trọ:</label>
        <input type="text" class="form-control" id="MotelName" name="MotelName" value="@ViewBag.MotelName" placeholder="Nhập tên người dùng">
    </div>
    <div class="form-group mx-sm-3 mb-2">
        <label for="motelID" class="mr-2">Vị trí:</label>
        <input type="text" class="form-control" id="Location" name="Location" value="@ViewBag.Location" placeholder="Nhập vị trí">
    </div>
    <div class="form-group mx-sm-3 mb-2">
        <label for="motelID" class="mr-2">Giá: từ:</label>
        <input type="text" class="form-control" id="Price1" name="Price1" value="@ViewBag.Price1" placeholder="Nhập giá tối thiểu">
    </div>
    <div class="form-group mx-sm-3 mb-2">
        <label for="motelID" class="mr-2">đến:</label>
        <input type="text" class="form-control" id="Price2" name="Price2" value="@ViewBag.Price2" placeholder="Nhập giá tối đa">
    </div>
    <div class="form-group mx-sm-3 mb-2">
        <label for="is_available" class="mr-2">Tình trạng:</label>
        @Html.DropDownList("is_available", new SelectList(new[] {
    new { Value = "Còn trống", Text = "Còn trống" },
    new { Value = "Hết phòng", Text = "Hết phòng" },
    new { Value = "Đang chờ duyệt", Text = "Đang chờ duyệt" }
}, "Value", "Text"), "Chọn tình trạng", new { @class = "form-control" })

    </div>

    <button type="submit" class="btn btn-danger mb-2 mx-sm-3">Tìm kiếm</button>
</form>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Ảnh</th>
            <th>Tên nhà trọ</th>
            <th>Vị Trí</th>
            <th>Giá</th>
            <th>Tình Trạng</th>
            <th>Chi Tiết</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var items in Model)
        {
            <tr>
                <td>
                    <img class="img-trang" src="@items.ImgLink" alt="Image" style="width:100px; height:auto;" />
                </td>
                <td>@items.MotelName</td>
                <td>@items.Location</td>
                <td>@items.Price</td>
                <td>
                    @using (Html.BeginForm("UpdateAvailability", "Home", FormMethod.Post))
                    {
                        @Html.Hidden("Motel_ID", items.Motel_ID)
                        <select name="is_available" onchange="this.form.submit()">
                            <option value="Còn trống" @(items.is_available == "Còn trống" ? "selected" : "")>Còn trống</option>
                            <option value="Hết phòng" @(items.is_available == "Hết phòng" ? "selected" : "")>Hết phòng</option>
                            <option value="Đang chờ duyệt" @(items.is_available == "Đang chờ duyệt" ? "selected" : "")>Đang chờ duyệt</option>
                        </select>
                    }
                </td>
                <td>
                    @using (Html.BeginForm("Details", "Home", FormMethod.Get))
                    {
                        @Html.Hidden("Motel_ID", items.Motel_ID)
                        <input type="submit" value="Xem chi tiết" class="btn btn-primary" />
                    }
                </td>
                <td>
                    <input type="button" value="Ngừng hoạt động" class="btn btn-danger" onclick="toggleReasonField('@items.Motel_ID')" />
                    <div id="reasonField_@items.Motel_ID" style="display: none; margin-top: 10px;">
                        @using (Html.BeginForm("Reject", "Home", FormMethod.Post))
                        {
                            @Html.Hidden("Motel_ID", items.Motel_ID)
                            <label for="reasonInput_@items.Motel_ID">Lý do hủy:</label>
                            <textarea id="reasonInput_@items.Motel_ID" name="Reason" class="form-control" rows="2" required></textarea>
                            <br />
                            <input type="submit" value="Gửi lý do" class="btn btn-primary" />
                        }
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="pagination-container">
    @Html.PagedListPager(Model, page => Url.Action("rental_management", new { page }), PagedListRenderOptions.Classic)
</div>
<script>
    function toggleReasonField(motelId) {
        var reasonField = document.getElementById("reasonField_" + motelId);
        reasonField.style.display = reasonField.style.display === "none" ? "block" : "none";
    }
</script>