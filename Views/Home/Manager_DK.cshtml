@model PagedList.IPagedList<_2home.ViewModels.User>
@using PagedList.Mvc;

@{
    ViewBag.Title = "Manager_DK";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<head>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
</head>
<h2>Quản Lý Người Dùng</h2>
<form method="get" action="@Url.Action("Manager_DK")" class="form-inline">
    <div class="form-group mx-sm-3 mb-2">
        <label for="fullname" class="mr-2">Tên Người Dùng:</label>
        <input type="text" class="form-control" id="fullname" name="fullname" value="@ViewBag.fullname" placeholder="Nhập tên người dùng">
    </div>

    <div class="form-group mx-sm-3 mb-2">
        <label for="motelID" class="mr-2">ID Khách Sạn:</label>
        <input type="text" class="form-control" id="motelID" name="motelID" value="@ViewBag.MotelID" placeholder="Nhập ID khách sạn">
    </div>

    <div class="form-group mx-sm-3 mb-2">
        <label for="userrole" class="mr-2">Vai Trò:</label>
        @Html.DropDownList("userrole", new SelectList(new[] {
            new { Value = "admin", Text = "Admin" },
            new { Value = "user", Text = "User" },
            new { Value = "innkeeper", Text = "Innkeeper" }
        }, "Value", "Text"), "Chọn vai trò", new { @class = "form-control" })
    </div>

    <button type="submit" class="btn btn-danger mb-2 mx-sm-3">Tìm kiếm</button>
</form>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Tên Tài Khoản</th>
            <th>Tên Đầy Đủ</th>
            <th>Mật Khẩu</th>
            <th>ID Khách Sạn</th>
            <th>Email</th>
            <th>Số Điện Thoại</th>
            <th>Vai Trò Người Dùng</th>
            <th>Giới Tính</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.ID_user</td>
                <td>@user.username</td>
                <td>@user.fullname</td>
                <td>@user.password</td>
                <td>@user.MotelID</td>
                <td>@user.Email</td>
                <td>@user.PhoneNumber</td>
                <td>
                    @using (Html.BeginForm("UpdateUserRole", "Home", FormMethod.Post))
                    {
                        @Html.Hidden("ID_user", user.ID_user)
                    <select name="userrole" onchange="this.form.submit()">
                        <option value="Admin" @(user.userrole == "Admin" ? "selected" : "")>Admin</option>
                        <option value="Innkeeper" @(user.userrole == "Innkeeper" ? "selected" : "")>Innkeeper</option>
                        <option value="user" @(user.userrole == "user" ? "selected" : "")>user</option>
                    </select>
                    }
                </td>
                <td>@user.gender</td>
            </tr>
        }
    </tbody>
</table>

<div class="pagination-container">
    @Html.PagedListPager(Model, page => Url.Action("Manager_DK", new { page }), PagedListRenderOptions.Classic)
</div>
