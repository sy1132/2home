@model PagedList.IPagedList<_2home.ViewModels.User>
@using PagedList.Mvc;

@{
    ViewBag.Title = "Quản Lý Người Dùng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Quản Lý Người Dùng</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Tên Tài Khoản</th>
            <th>Tên Đầy Đủ</th>
            <th>Mật Khẩu</th>
            <th>ID Khách Sạn</th>
            <th>Email</th>
            <th>Số Điện Thoại</th>
            <th>Vai Trò Người Dùng</th>
            <th>Giới Tính</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.ID_user</td>
                <td>@user.username</td>
                <td>@user.fullname</td>
                <td>@user.password</td>
                <td>@user.MotelID</td>
                <td>@user.Email</td>
                <td>@user.PhoneNumber</td>
                <td>@user.userrole</td>
                <td>@user.gender</td>
            </tr>
        }
    </tbody>
</table>

<div class="pagination-container">
    @Html.PagedListPager(Model, page => Url.Action("Manager_DK", new { page }), PagedListRenderOptions.Classic)
</div>
