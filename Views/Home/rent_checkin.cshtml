
@model PagedList.IPagedList<_2home.Models.RoomBill>
@using PagedList.Mvc;

@{
    ViewBag.Title = "rent_checkin";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<head>
</head>
<style>
    .btn-detail {
        background-color: #ff9800; 
        color: white;
        padding: 5px 10px;
        border-radius: 5px;
        text-decoration: none;
    }

        .btn-detail:hover {
            background-color: #e68900; 
        }
   
    .btn {
        padding: 5px 10px;
        border: none;
        border-radius: 5px;
        color: white;
        cursor: pointer;
        text-decoration: none;
    }

    .btn-info {
        background-color: #007bff;
    }

        .btn-info:hover {
            background-color: #0056b3;
        }
</style>

<div class="container">
    <div class="card">
        <div class="card-header">
            <h5>Tổng Kết Quá Trình Thanh Toán</h5>
        </div>
        <div class="card-body">
            <p>Tổng tiền điện: <strong>@String.Format("{0:N0} VNĐ", ViewBag.TotalElectricity ?? 0)</strong></p>
            <p>Tổng tiền nước: <strong>@String.Format("{0:N0} VNĐ", ViewBag.TotalWater ?? 0)</strong></p>
            <p>Tổng chi phí phát sinh: <strong>@String.Format("{0:N0} VNĐ", ViewBag.TotalAdditionalCharges ?? 0)</strong></p>
            <p>Tổng tiền trọ: <strong>@String.Format("{0:N0} VNĐ", ViewBag.TotalRent ?? 0)</strong></p>
            <p>Tổng số tiền phải thanh toán: <strong>@String.Format("{0:N0} VNĐ", ViewBag.TotalAmountDue ?? 0)</strong></p>
            <p>Tổng tiền phòng đã trả: <strong>@String.Format("{0:N0} VNĐ", ViewBag.TotalPaid ?? 0)</strong></p>
            <p>Số tiền nợ: <strong>@String.Format("{0:N0} VNĐ", ViewBag.TotalDebt ?? 0)</strong></p>
            <form method="post" action="@Url.Action("UpdatePayment", "Home")">
                <div class="form-group">
                    <label for="paymentAmount">Nhập số tiền mà người thuê đã đóng:</label>
                    <input type="number" name="paymentAmount" class="form-control" id="paymentAmount" placeholder="Số tiền" min="0" required />
                    <input type="hidden" name="ID_User" value="@ViewBag.ID_User" />

                </div>
                <button type="submit" class="btn btn-info">Cập nhật</button>
            </form>
        </div>
    </div>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Ngày cập nhật</th>
                <th>Tổng tiền điện</th>
                <th>Tổng tiền nước</th>
                <th>Chi phí phát sinh</th>
                <th>Tiền trọ</th>
                <th>Tổng tiền </th>
                <th>Xem chi tiết</th>

            </tr>
        </thead>
        <tbody>
            @foreach (var items in Model)
            {
                <tr>

                    <td>@items.Date_of_Issue</td>
                    <td>@String.Format("{0:0,0}", items.Electricity_Bill) VNĐ</td>
                    <td>@String.Format("{0:0,0}", items.Water_Bill) VNĐ</td>
                    <td>@String.Format("{0:0,0}", items.Additional_Charges) VNĐ</td>
                    <td>@String.Format("{0:0,0}", items.Price) VNĐ</td>
                    <td>@String.Format("{0:0,0}", items.Total_Amount_Due) VNĐ</td>

                    <td>
                        <a href="@Url.Action("detailsbill", "Home", new { id = items.Bill_ID })" class="btn btn-detail">Xem Chi Tiết</a>
                    </td>
                </tr>
            }

        </tbody>
    </table>

    <div class="text-center">
        @Html.PagedListPager(Model, page => Url.Action("rent_checkin", new { page, size = ViewBag.currentSize, ID_User = ViewBag.ID_User }), PagedListRenderOptions.ClassicPlusFirstAndLast)
    </div>

