
@model PagedList.IPagedList<_2home.Models.RoomBill>
@using PagedList.Mvc;

@{
    ViewBag.Title = "rent_check";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<head>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
</head>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Ngày cập nhật</th>
            <th>Tổng tiền điện</th>
            <th>Tổng tiền nước</th>
            <th>Chi phí phát sinh</th>
            <th>Tiền trọ</th>
            <th>Tổng tiền </th>
            <th>chi tiết</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var items in Model)
        {
            <tr>

                <td>@items.Date_of_Issue</td>
                <td>@items.Electricity_Bill</td>
                <td>@items.Water_Bill</td>
                <td>@items.Additional_Charges</td>
                <td>@items.Price</td>
                <td>@items.Total_Amount_Due</td>
                <td>
                    <a href="@Url.Action("Capnhat", "Home", new { id = items.Room_ID })" class="btn btn-info">Xem chi tiết</a>
                </td>
            </tr>
        }

    </tbody>
</table>



