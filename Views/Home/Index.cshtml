@{
    ViewBag.Title = "Trang chủ";
}
<head>
    <link href="~/asset/css/index.css" rel="stylesheet" />
</head>

@foreach (var item in Model.MotelItems)
{
    <div class="row">
        <img class="img-trang" src="@item.Image.Link" alt="Image" />
        <div>@item.Motel.SomeProperty</div>
    </div>
}
