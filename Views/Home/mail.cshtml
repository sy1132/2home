@model PagedList.IPagedList<_2home.ViewModels.viewmail>
@using PagedList.Mvc;
@{
    ViewBag.Title = "Mail List";
}

<h2>Mail List</h2>



<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>người gửi</th>
            <th>người nhận</th>
            <th>ngày gửi</th>
            <th>nội dung</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var mail in Model)
        {
            <tr>
                <td>@mail.user1</td>
                <td>@mail.user2</td>
                <td>@mail.SendDate</td>
                <td>@mail.Content</td>
                <td>
                <td>
                    @if (mail.Content.Contains("Xin vào phòng trọ với mã phòng: "))
                    {
                        var roomId = mail.Content.Split(new[] { "mã phòng: " }, StringSplitOptions.None).LastOrDefault()?.Trim();
                        if (!string.IsNullOrEmpty(roomId))
                        {
                            <form method="post" action="@Url.Action("AcceptRoom", "Home")">
                                <input type="hidden" name="roomId" value="@roomId" />
                                <button type="submit" class="btn btn-success">Đồng ý</button>
                            </form>
                            <form method="post" action="@Url.Action("RejectRoom", "Home")">
                                <input type="hidden" name="roomId" value="@roomId" />
                                <button type="submit" class="btn btn-danger">Từ chối</button>
                            </form>
                        }
                    }
                </td>
                </td>
            </tr>
        }

    </tbody>
</table>
<form method="get" action="@Url.Action("mail")">
    <div class="form-group">
        <label for="size">Items per page:</label>
        @Html.DropDownList("size", (IEnumerable<SelectListItem>)ViewBag.size, new { @class = "form-control", @onchange = "this.form.submit();" })
    </div>
</form>
<div class="text-center">
    @Html.PagedListPager(Model, page => Url.Action("mail", new { page, size = ViewBag.currentSize }))
</div>
