@{
    ViewBag.Title = "Confirm Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<head>
    <link href="~/asset/css/login.css" rel="stylesheet" />
</head>

<div class="card mx-auto shadow-lg p-3 m-5 bg-white rounded" style="width: 50rem;">
    <form method="post" action="@Url.Action("ConfirmPassword", "Home")" class="row g-3">
        <h2 class="card-title text-center mb-4">Xác nhận mật khẩu</h2>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
        }

        <div class="col-md-12">
            <label for="password" class="form-label">Mật khẩu</label>
            <input type="password" class="form-control" id="password" name="password" required />
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-primary w-100">Xác nhận</button>
        </div>
    </form>
</div>
