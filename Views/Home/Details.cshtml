@model _2home.ViewModels.index_Viewmodel
@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
}
<body>
    <div class="container mt-4 bg-light p-3 border-dark">
        <div class="row">
            <div class="col-md-4">
                <video class="card-img w-50 " controls>
                    <source src="@Model.Link" type="video/mp4">
                    Trình duyệt của bạn không hỗ trợ thẻ video.
                </video>
                <!-- Thêm hình ảnh -->
                <img class="card-img w-50" src="@Model.ImgLink" alt="Image" />
            </div>
            <div class="col-md-8">
                <p><strong>Tên nhà trọ:</strong> @Model.MotelName</p>
                <p><strong>Vị trí:</strong> @Model.Location</p>
                <p><strong>Giá:</strong> @Model.Price</p>
                <p><strong>Tình trạng:</strong> @Model.is_available</p>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>


