@model _2home.ViewModels.pic

@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Chi tiết nhà trọ</h2>

<video width="600" height="400" controls>
    <source src="@Model.Link" type="video/mp4">
    Trình duyệt của bạn không hỗ trợ thẻ video.
</video>

@if (Model.ImgLinks != null && Model.ImgLinks.Any())
{
    <div id="motelImagesCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            @for (var i = 0; i < Model.ImgLinks.Count; i++)
            {
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <img src="@Model.ImgLinks[i]" class="d-block w-100" alt="Motel Image" style="max-width:600px; height:auto;" />
                </div>
            }
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#motelImagesCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#motelImagesCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
}
else
{
    <p>Không có ảnh nào để hiển thị.</p>
}

<p><strong>Tên nhà trọ:</strong> @Model.MotelName</p>
<p><strong>Vị trí:</strong> @Model.Location</p>
<p><strong>Giá:</strong> @Model.Price</p>
<p><strong>Tình trạng:</strong> @Model.is_available </p>
