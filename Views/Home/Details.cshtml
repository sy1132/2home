@model _2home.ViewModels.pic

@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Chi tiết nhà trọ</h2>
<div class="row mt-4">
    <div class="col-md-3">
        <div class="card mb-4" style="border: none;">
            <div class="card-body">
                <h4>Nhà trọ có thể muốn xem</h4>
                @if (Model.RelatedMotels != null && Model.RelatedMotels.Any())
                {
                    foreach (var relatedMotel in Model.RelatedMotels)
                    {
                        <div class="mb-3">
                            <div class="card" style="height: 120px;">
                                <div class="card-body text-center" style="padding: 10px;">
                                    <a href="@relatedMotel.Linkd" style="text-decoration: none; color: black;">
                                        <h5 style="font-size: 12px;">@relatedMotel.MotelName</h5>
                                        <img class="img-fluid" src="@relatedMotel.Link" alt="Image" style="max-height: 60px;" />
                                        <p style="font-size: 10px;">@relatedMotel.Location</p>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-center" style="color: black;">Không có motel nào để hiển thị.</p>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card mb-4">
            <div class="card-body">
                <div id="mainDisplay" style="height: 412px; margin: 0 auto;">
                    <video id="mainVideo" style="width: 100%; height: 100%; object-fit: cover;"; controls>
                        <source src="@Model.Link" type="video/mp4">
                        Trình duyệt của bạn không hỗ trợ thẻ video.
                    </video>
                    <img id="mainImage" src="~/asset/images/video.png" style="display:none; width: 100%; height: 100%;" />
                </div>
                @if (Model.ImgLinks != null && Model.ImgLinks.Any())
                {
                    <div class="mt-4 d-flex justify-content-center">
                        <img src="~/asset/images/video.png" class="img-thumbnail mx-1" style="width: 104.8px; height: 104.8px; cursor: pointer;" onclick="showVideo('@Model.Link')" />
                        @foreach (var imgLink in Model.ImgLinks)
                        {
                            <img src="@imgLink" class="img-thumbnail mx-1" style="width: 104.8px; height: 104.8px; cursor: pointer;" onclick="showImage('@imgLink')" />
                        }
                    </div>
                }
                else
                {
                    <p class="text-center">Không có ảnh nào để hiển thị.</p>
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <h4>Thông tin nhà trọ</h4>
                <p><strong>Tên nhà trọ:</strong> @Model.MotelName</p>
                <p><strong>Vị trí:</strong> @Model.Location</p>
                <p><strong>Giá:</strong> @Model.Price</p>
                <p><strong>Tình trạng:</strong> @Model.is_available </p>
                <p><strong>Tiền đặt cọc trước của phòng:</strong> @Model.Deposit </p>
                <p><strong>Chi tiết:</strong> @Model.Details </p>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card sticky-top">
            <div class="card-body text-center">
                <img src="~/asset/images/user.jpg" class="rounded-circle mb-3" alt="Profile Image" style="width: 100px; height: 100px;">
                <h5>Thông tin chủ nhà</h5>
                <p>@Model.fullname</p>
                <p>Số điện thoại: @Model.phonenumber</p>
                <button class="btn btn-primary">Liên hệ</button>
            </div>
        </div>
    </div>
</div>

<script>
    function showImage(imgLink) {
        document.getElementById('mainVideo').style.display = 'none';
        document.getElementById('mainImage').style.display = 'block';
        document.getElementById('mainImage').src = imgLink;
    }

    function showVideo(videoLink) {
        document.getElementById('mainImage').style.display = 'none';
        document.getElementById('mainVideo').style.display = 'block';
        document.getElementById('mainVideo').src = videoLink;
    }

    showVideo('@Model.Link');
</script>
