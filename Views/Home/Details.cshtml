@model _2home.ViewModels.index_Viewmodel
@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
}
<body>
        <div class="card-header align-content-center">
            <h2 >Chi tiết nhà trọ</h2>

        </div>
        <div class="d-flex">
            <div class="d-flex">
                <video class="card-img w-50 " controls>
                    <source src="@Model.Link" type="video/mp4">
                    Trình duyệt của bạn không hỗ trợ thẻ video.
                </video>
                <img class="card-img w-50" src="@Model.ImgLink" alt="Image" />
            </div>

            <div class="card-body">
                <p><strong>Tên nhà trọ:</strong> @Model.MotelName</p>
                <p><strong>Vị trí:</strong> @Model.Location</p>
                <p><strong>Giá:</strong> @Model.Price</p>
                <p><strong>Tình trạng:</strong> @Model.is_available</p>
            </div>
        </div>
    

</body>
<body>
    <div class="container mt-4">
        <div class="row">
            <div class="col-md-4">
                <!-- Thêm hình ảnh -->
                <img src="path_to_image.jpg" class="img-fluid" alt="Hình ảnh nhà cho thuê">
            </div>
            <div class="col-md-8">
                <h2>Cho thuê nhà nguyên căn 2 tầng, ngay Đại lộ Võ Văn Kiệt, giá tốt</h2>
                <!-- Mô tả chi tiết -->
                <p>Địa chỉ: Vĩnh Châu, Phường Vĩnh Phước, Thành phố Cần Thơ, Bình Dương</p>
                <p>Giá: 1.3 tỷ đồng/năm</p>
                <p>Diện tích: 130m²</p>
                <ul>
                    <li>5 phòng ngủ, 2 phòng tắm</li>
                    <li>Có sân thượng rộng</li>
                    <li>Fully furnished</li>
                </ul>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>


