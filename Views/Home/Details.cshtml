@model _2home.ViewModels.pic

@{
    ViewBag.Title = "Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Chi tiết nhà trọ</h2>

<div class="row">
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-body">
                <div id="mainDisplay" style="height: 412px; margin: 0 auto;">
                    <video id="mainVideo" width="100%" height="100%" controls>
                        <source src="@Model.Link" type="video/mp4">
                        Trình duyệt của bạn không hỗ trợ thẻ video.
                    </video>
                    <img id="mainImage" src="" style="display:none; width: 100%; height: 100%;" />
                </div>

                @if (Model.ImgLinks != null && Model.ImgLinks.Any())
                {
                    <div class="mt-4 d-flex justify-content-center">
                        <img src="@Model.Link" class="img-thumbnail mx-1" style="width: 104.8px; height: 104.8px; cursor: pointer;" onclick="showVideo('@Model.Link')" />
                        @foreach (var imgLink in Model.ImgLinks)
                        {
                            <img src="@imgLink" class="img-thumbnail mx-1" style="width: 104.8px; height: 104.8px; cursor: pointer;" onclick="showImage('@imgLink')" />
                        }
                    </div>
                }
                else
                {
                    <p class="text-center">Không có ảnh nào để hiển thị.</p>
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <h4>Thông tin nhà trọ</h4>
                <p><strong>Tên nhà trọ:</strong> @Model.MotelName</p>
                <p><strong>Vị trí:</strong> @Model.Location</p>
                <p><strong>Giá:</strong> @Model.Price</p>
                <p><strong>Tình trạng:</strong> @Model.is_available </p>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card sticky-top">
            <div class="card-body text-center">
                <img src="path_to_profile_image" class="rounded-circle mb-3" alt="Profile Image" style="width: 100px; height: 100px;">
                <h5>Thông tin chủ nhà</h5>
                <p>Tên chủ nhà</p>
                <p>Số điện thoại: 0123456789</p>
                <button class="btn btn-primary">Liên hệ</button>
            </div>
        </div>
    </div>
</div>

<script>
    function showImage(imgLink) {
        document.getElementById('mainVideo').style.display = 'none';
        document.getElementById('mainImage').style.display = 'block';
        document.getElementById('mainImage').src = imgLink;
    }

    function showVideo(videoLink) {
        document.getElementById('mainImage').style.display = 'none';
        document.getElementById('mainVideo').style.display = 'block';
        document.getElementById('mainVideo').src = videoLink;
    }

    // Initially show the video
    showVideo('@Model.Link');
</script>
