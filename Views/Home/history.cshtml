@model PagedList.IPagedList<_2home.ViewModels.pay>
@using PagedList.Mvc
@using PagedList

@{
    ViewBag.Title = "history";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>History</h2>

<div>
    <h4>Payment History</h4>
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Tên</th>
                <th>Tổng tiền</th>
                <th>Ngày</th>
                <th>Thông tin hóa đơn</th>
                <th>Tình trạng</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.UserName</td>
                    <td>@item.Amount</td>
                    <td>@item.PaymentDate</td>
                    <td>@item.TransactionID</td>
                    <td>@item.Status</td>
                    
                </tr>
            }
        </tbody>
    </table>

    <div class="pagination-container">
        @Html.PagedListPager(Model, page => Url.Action("rent_checkin", new { page, size = ViewBag.currentSize, ID_User = ViewBag.ID_User }), PagedListRenderOptions.ClassicPlusFirstAndLast)
    </div>
</div>
