@model Tuple<List<_2home.ViewModels.Motel>, List<_2home.ViewModels.Motel>>

@{
    ViewBag.Title = "Thông tin người dùng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm rounded">
                <div class="card-header bg-light text-dark">
                    <h2 class="card-title">Thông tin người dùng</h2>
                </div>
                <div class="card-body">
                    <p><strong>Họ và tên:</strong> @ViewBag.Fullname</p>
                    <p><strong>Email:</strong> @ViewBag.Email</p>
                    <p><strong>Số điện thoại:</strong> @ViewBag.PhoneNumber</p>
                    <p><strong>Giới tính:</strong> @ViewBag.Gender</p>
                </div>
                <a class="dropdown-item text-dark" href="@Url.Action("Settings", "Home")">
                    <i class="fas fa-cog"></i> Cài đặt
                </a>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card shadow-sm rounded">
                <div class="card-header bg-light text-dark d-flex justify-content-between align-items-center">
                    <div class="btn-group" role="group" aria-label="Basic example">
                        <button type="button" class="btn btn-outline-secondary" id="btnMotel">Số trọ đã đăng ký</button>
                        <button type="button" class="btn btn-outline-secondary" id="btnRoom">Số phòng đã đăng cho thuê</button>
                    </div>
                </div>
                <div class="card-body">
                    <table class="table table-hover mt-3" id="motelTable">
                        <thead class="thead-light">
                            <tr>
                                <th>Tên trọ</th>
                                <th>Địa điểm</th>
                                <th>Giá</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Item1) 
                            {
                                <tr>
                                    <td>@item.MotelName</td>
                                    <td>@item.Location</td>
                                    <td>@item.Price</td>
                                    <td>@item.Debt</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <table class="table table-hover mt-3" id="roomTable" style="display:none;">
                        <thead class="thead-light">
                            <tr>
                                <th>Tên phòng</th>
                                <th>Trạng thái</th>
                                <th>Người thuê</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Item2) // Sử dụng Model.Item2 cho danh sách Room
                            {
                                <tr>
                                    <td>@item.room_ID</td>
                                    <td>@item.Room_Status</td>
                                    <td>@item.fullname</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('btnMotel').addEventListener('click', function () {
        document.getElementById('motelTable').style.display = 'table';
        document.getElementById('roomTable').style.display = 'none';
    });

    document.getElementById('btnRoom').addEventListener('click', function () {
        document.getElementById('motelTable').style.display = 'none';
        document.getElementById('roomTable').style.display = 'table';
    });
</script>

<style>
    .card {
        border-radius: 12px;
        transition: all 0.3s ease;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
        }

    .btn-outline-secondary {
        border-radius: 20px;
        transition: background-color 0.2s ease;
    }

        .btn-outline-secondary:hover {
            background-color: #f0f0f0;
        }

    .table-hover tbody tr:hover {
        background-color: #f9f9f9;
    }
</style>
