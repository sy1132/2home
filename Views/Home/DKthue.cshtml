        ben_cat: {
            wards: {
                "An Điền": ["An Mỹ", "An Sơn", "Kiến An", "Kiến Điền", "Tân Lập"],
                "An Tây": ["An Thành", "Đồng Sỏi", "Lồ Ồ", "Rạch Bắp"],
                "Chánh Phú Hòa": ["1A", "1B", "2", "3", "4", "5", "7", "8", "9"],
                "Hòa Lợi": ["An Hòa", "An Lợi", "Bến Đồn", "Phú Hòa", "Phú Nghị"],
