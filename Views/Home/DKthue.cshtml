            wards: {
                "Hội Nghĩa": ["1", "2", "3", "4", "5", "Nông trường cao su 1", "Nông trường cao su 2"],
                "Khánh Bình": ["Bình Chánh", "Bình Chánh Đông", "Bình Khánh", "Khánh Lộc", "Khánh Tân", "Khánh Vân", "Long Bình"],
                "Phú Chánh": ["Chánh Long", "Phú Bưng", "Phú Thọ", "Phú Trung"],
                "Tân Hiệp": ["Bà Trì", "Ông Đông", "Tân Bình", "Tân Hội", "Tân Long", "Tân Phú"],
                "Tân Phước Khánh": ["Bình Hòa 1", "Bình Hòa 2", "Khánh Hòa", "Khánh Hội", "Khánh Long", "Khánh Lộc", "Khánh Lợi", "Khánh Thạnh"],
                "Tân Vĩnh Hiệp": ["Hóa Nhựt", "Tân An", "Tân Hóa", "Vĩnh An", "Vĩnh Trường"]
            }
