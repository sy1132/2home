    };


    document.getElementById('inputCity').addEventListener('change', function () {
        const city = this.value;
        const wardSelect = document.getElementById('inputWard');
        const neighborhoodSelect = document.getElementById('neighborhood');

        // Clear previous options
        wardSelect.innerHTML = '<option value="">Select Ward</option>';
        neighborhoodSelect.innerHTML = '<option value="">Select Neighborhood</option>';
        wardSelect.disabled = true;
        neighborhoodSelect.disabled = true;

        if (city && data[city]) {
            const wards = data[city].wards;
            wardSelect.disabled = false;

            for (const ward in wards) {
                const option = document.createElement('option');
                option.value = ward;
                option.textContent = ward;
                option.text = ward.replace(/_/g, ' ').replace(/\b\w/g, char => char.toUpperCase());
                wardSelect.add(option);
            }
        }
    });

    document.getElementById('inputWard').addEventListener('change', function () {
        const city = document.getElementById('inputCity').value;
        const ward = this.value;
        const neighborhoodSelect = document.getElementById('neighborhood');

        // Clear previous options
        neighborhoodSelect.innerHTML = '<option value="">Select Neighborhood</option>';
        neighborhoodSelect.disabled = true;

        if (ward && data[city] && data[city].wards[ward]) {
            const neighborhoods = data[city].wards[ward];
            neighborhoodSelect.disabled = false;

            neighborhoods.forEach(function (neighborhood) {
                const option = document.createElement('option');
                option.value = neighborhood;
                option.text = neighborhood;
                neighborhoodSelect.add(option);
            });
        }
    });


    function updateWards() {
        const city = document.getElementById('inputCity').value;
        const wardSelect = document.getElementById('inputWard');
        const districtSelect = document.getElementById('inputDistrict');

        // Xóa tùy chọn hiện tại của phường và khu
        wardSelect.innerHTML = '<option value="">Chọn phường...</option>';
        districtSelect.innerHTML = '<option value="">Chọn khu...</option>';
        districtSelect.disabled = true;

        if (city && data[city]) {
            const wards = data[city];
            for (let ward in wards) {
                const option = document.createElement('option');
                option.value = ward;
                option.textContent = ward.replace(/_/g, ' ').replace(/\b\w/g, char => char.toUpperCase());
                wardSelect.appendChild(option);
            }
            wardSelect.disabled = false;
        } else {
            wardSelect.disabled = true;
        }
    }

    // Hàm cập nhật khu khi thay đổi phường
    function updateDistricts() {
        const city = document.getElementById('inputCity').value;
        const ward = document.getElementById('inputWard').value;
        const districtSelect = document.getElementById('inputDistrict');

        // Xóa tùy chọn hiện tại của khu
        districtSelect.innerHTML = '<option value="">Chọn khu...</option>';

        if (city && ward && data[city][ward]) {
            const neighborhoods = data[city][ward];
            neighborhoods.forEach(neighborhood => {
                const option = document.createElement('option');
                option.value = neighborhood;
                option.textContent = neighborhood;
                districtSelect.appendChild(option);
            });
            districtSelect.disabled = false;
        } else {
            districtSelect.disabled = true;
        }
    }
</script>
<div class="card mx-auto shadow-lg p-3 m-5 bg-white rounded" style="width: 50rem;">
    <form id="registrationForm" asp-action="RegisterDK" enctype="multipart/form-data" method="post" class="row g-3">
        <h2 class="card-title text-center mb-4">Đăng ký cho thuê phòng trọ</h2>
        <div class="col-md-6">
            <label for="inputRoomName" class="form-label">Tên phòng trọ</label>
            <input type="text" class="form-control" id="inputRoomName" name="roomName">
            <span class="error-message" id="roomNameError"></span>
        </div>
        <div class="col-md-6">
            <label for="inputRooms" class="form-label">Số phòng</label>
            <input type="number" class="form-control" id="inputRooms" name="Rooms" min="0">
            <span class="error-message" id="roomsError"></span>
        </div>
        <div class="col-12">
            <label for="inputLocation" class="form-label">Địa chỉ</label>
            <input type="text" class="form-control" id="inputLocation" name="LocationName">
            <span class="error-message" id="locationError"></span>
        </div>
        <div class="col-md-6">
            <label for="inputCity" class="form-label">Thành phố</label>
            <select id="inputCity" class="form-select" name="City" onchange="updateWards()">
                <option selected value="">Chọn thành phố...</option>
                <option value="di_an">Dĩ An</option>
                <option value="thuan_an">Thuận An</option>
                <option value="thu_dau_mot">Thủ Dầu Một</option>
                <option value="tan_uyen">Tân Uyên</option>
                <option value="ben_cat">Bến Cát</option>
            </select>
            <span class="error-message" id="cityError"></span>
        </div>
        <div class="col-md-6">
            <label for="inputWard" class="form-label">Phường</label>
            <select id="inputWard" class="form-select" name="Ward" onchange="updateDistricts()">
                <option selected value="">Chọn phường...</option>
            </select>
            <span class="error-message" id="wardError"></span>
        </div>
        <div class="col-md-6">
            <label for="inputDistrict" class="form-label">Khu</label>
            <select id="inputDistrict" class="form-select" name="District">
                <option selected value="">Chọn khu...</option>
            </select>
            <span class="error-message" id="districtError"></span>
        </div>
        <div class="col-md-6">
            <label for="inputPrice" class="form-label">Giá (VNĐ)</label>
            <input type="number" class="form-control" id="inputPrice" name="Price">
            <span class="error-message" id="priceError"></span>
        </div>
        <div class="col-md-6">
            <label for="inputImage" class="form-label">Hình ảnh</label>
            <input type="file" class="form-control" id="inputImage" name="Images" accept="image/*" multiple>
            <span class="error-message" id="imageError"></span>
            <div class="preview-container" id="imagePreviewContainer"></div>
        </div>
        <div class="col-md-6">
            <label for="inputVideo" class="form-label">Video</label>
            <input type="file" class="form-control" id="inputVideo" name="Videos" accept="video/*" multiple>
            <span class="error-message" id="videoError"></span>
            <div class="preview-container" id="videoPreviewContainer"></div>
        </div>
        <div class="col-12">
            <label for="inputDetails" class="form-label">Chi tiết</label>
            <textarea class="form-control" id="inputDetails" name="Details" rows="4" placeholder="Nhập chi tiết phòng trọ..."></textarea>
            <span class="error-message" id="detailsError"></span>
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-primary w-100">Đăng</button>
        </div>
        <div class="col-12 text-center">
            <p id="message"></p>
        </div>
    </form>
</div>

<!-- Modal for full-screen view -->
<div id="myModal" class="modal">
    <span class="close">&times;</span>
    <span class="nav-button prev">&#10094;</span>
    <span class="nav-button next">&#10095;</span>
    <img class="modal-content" id="img01">
    <video class="modal-content" id="vid01" controls></video>
</div>

<script>
    let currentIndex = 0;
    let files = [];

    document.getElementById('inputImage').addEventListener('change', function () {
        const previewContainer = document.getElementById('imagePreviewContainer');
        previewContainer.innerHTML = '';
        const imageFiles = Array.from(this.files);
        imageFiles.forEach((file, index) => {
            const img = document.createElement('img');
            img.src = URL.createObjectURL(file);
            img.addEventListener('click', function () {
                showModal(index, 'image');
            });
            previewContainer.appendChild(img);
        });
        files = files.concat(imageFiles); // Combine image and video files
    });

    document.getElementById('inputVideo').addEventListener('change', function () {
        const previewContainer = document.getElementById('videoPreviewContainer');
        previewContainer.innerHTML = '';
        const videoFiles = Array.from(this.files);
        videoFiles.forEach((file, index) => {
            const video = document.createElement('video');
            video.src = URL.createObjectURL(file);
            video.addEventListener('click', function () {
                showModal(index, 'video');
            });
            previewContainer.appendChild(video);
        });
        files = files.concat(videoFiles); // Combine image and video files
    });

    function showModal(index, type) {
        currentIndex = index;
        const modal = document.getElementById('myModal');
        const img = document.getElementById('img01');
        const video = document.getElementById('vid01');
        if (type === 'image') {
            img.src = URL.createObjectURL(files[index]);
            img.style.display = 'block';
            video.style.display = 'none';
        } else {
            video.src = URL.createObjectURL(files[index]);
            video.style.display = 'block';
            img.style.display = 'none';
        }
        modal.style.display = 'flex';
    }

    document.querySelector('.close').addEventListener('click', function () {
        const modal = document.getElementById('myModal');
        modal.style.display = 'none';
    });

    window.addEventListener('click', function (event) {
        const modal = document.getElementById('myModal');
        if (event.target === modal) {
            modal.style.display = 'none';
        }
    });

    document.getElementById('registrationForm').addEventListener('submit', function (event) {
        // Reset error messages
        document.querySelectorAll('.error-message').forEach(el => el.textContent = '');
        document.getElementById('message').textContent = '';

        let hasError = false;

        // Validate Room Name
        const roomName = document.getElementById('inputRoomName').value.trim();
        if (!roomName) {
            document.getElementById('roomNameError').textContent = 'Tên phòng trọ không được để trống.';
            hasError = true;
        }

        // Validate Number of Rooms
        const rooms = document.getElementById('inputRooms').value;
        if (!rooms || rooms <= 0) {
            document.getElementById('roomsError').textContent = 'Số phòng phải lớn hơn 0.';
            hasError = true;
        }

        // Validate Location
        const location = document.getElementById('inputLocation').value.trim();
        if (!location) {
            document.getElementById('locationError').textContent = 'Địa chỉ không được để trống.';
            hasError = true;
        }

        // Validate City
        const city = document.getElementById('inputCity').value;
        if (!city) {
            document.getElementById('cityError').textContent = 'Bạn chưa chọn thành phố.';
            hasError = true;
        }

        // Validate Ward
        const ward = document.getElementById('inputWard').value;
        if (!ward) {
            document.getElementById('wardError').textContent = 'Bạn chưa chọn phường.';
            hasError = true;
        }

        // Validate District
        const district = document.getElementById('inputDistrict').value;
        if (!district) {
            document.getElementById('districtError').textContent = 'Bạn chưa chọn khu.';
            hasError = true;
        }
        const details = document.getElementById('inputDetails').value.trim();
        if (!details) {
            document.getElementById('detailsError').textContent = 'Bạn phải nhập chi tiết phòng trọ.';
            hasError = true;
        }
        // Validate Price
        const price = document.getElementById('inputPrice').value;
        if (!price || price <= 0) {
            document.getElementById('priceError').textContent = 'Giá phải lớn hơn 0.';
            hasError = true;
        }

        // Validate Images
        if (document.getElementById('inputImage').files.length === 0) {
            document.getElementById('imageError').textContent = 'Bạn phải chọn ít nhất một hình ảnh.';
            hasError = true;
        }

        // Validate Videos
        if (document.getElementById('inputVideo').files.length === 0) {
            document.getElementById('videoError').textContent = 'Bạn phải chọn ít nhất một video.';
            hasError = true;
        }

        if (hasError) {
            event.preventDefault(); // Prevent form submission if there are validation errors
        } else {
            // Show success message if no errors
            document.getElementById('message').textContent = 'Đăng ký thành công!';
            document.getElementById('message').style.color = 'green'; // Optional: Change text color to green
        }
    });
</script>