                "Dĩ An": ["Bình Minh 1", "Bình Minh 2", "Đông Tân", "Nhị Đồng 1", "Nhị Đồng 2", "Thắng Lợi 1", "Thắng Lợi 2", "Thống Nhất 1", "Thống Nhất 2"],
