                "Phú Lợi": ["1", "2", "3", "4", "5", "6", "7", "8", "9"],
                "Phú Mỹ": ["1", "2", "3", "4", "5", "6", "7", "8"],
                "Phú Tân": ["1", "2", "3"],
                "Phú Thọ": ["2", "3", "4", "5", "6", "7", "8"],
                "Tân An": ["1", "2", "3", "4", "5", "6", "7", "8", "9"],
                "Tương Bình Hiệp": ["1", "2", "3", "4", "5", "6", "7", "8"]
            }
        },
