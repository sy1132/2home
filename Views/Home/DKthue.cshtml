
@{
    ViewBag.Title = "DKthue";
}

<head>

    <link href="~/asset/css/DK.css" rel="stylesheet" />
</head>

<div id="wrapper">
    <form action="" id="form-login">
        <h1 class="form-heading">
            Form đăng ký cho thuê
        </h1>
        <div class="form-group">
            <input type="text" class="form-input" placeholder="Tên phòng trọ" />
        </div>
        <div class="form-group">
            <input type="text" class="form-input" placeholder="Địa chỉ" />
        </div>
        <div class="form-group">
            <input type="text" class="form-input" placeholder="Giá" />
        </div>
            <div >
                <label for="ImageFile" class="color">Select Image</label>
                <input type="file" name="ImageFile" id="ImageFile" />
                <span asp-validation-for="ImageFile" class="text-danger"></span>
            </div>

            <input type="submit" value="Đăng ký" class="form-submit" />
        </form>
</div>