@model _2home.ViewModels.room

@{
    ViewBag.Title = "Chỉnh Sửa Hợp Đồng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-center mb-4">Chỉnh Sửa Hợp Đồng</h2>

<div class="container">
    @using (Html.BeginForm("EditContract", "Home", FormMethod.Post, new { @class = "bg-light p-4 rounded shadow" }))
    {
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <strong>Tên người thuê:</strong>
            <span class="form-control-plaintext">@Model.fullname</span>
        </div>

        <div class="mb-3">
            <strong>Ngày cập nhật:</strong>
            <span class="form-control-plaintext">@DateTime.Now.ToString("yyyy-MM-dd")</span>
        </div>

        <div class="mb-3">
            <strong>Tiền cọc:</strong>
            @Html.TextBoxFor(m => m.Deposit, new { @class = "form-control", placeholder = "Nhập tiền cọc", value = Model.Deposit })
        </div>

        <div class="mb-3">
            <strong>Thời hạn hợp đồng (tháng):</strong>
            @Html.TextBoxFor(m => m.contract, new { @class = "form-control", placeholder = "Nhập thời hạn hợp đồng", value = Model.contract })
        </div>

        <input type="hidden" name="Room_ID" value="@Model.Room_ID" />

        <div class="text-center">
            <button type="submit" class="btn btn-primary">Lưu Thay Đổi</button>
            @Html.ActionLink("Quay lại", "viewContractinkeeper", new { Motel_ID = Model.Motel_ID }, new { @class = "btn btn-secondary" })
        </div>
    }
</div>

<style>
    body {
        background-color: #f8f9fa;
    }

    .rounded {
        border-radius: 0.5rem;
    }

    .shadow {
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }
</style>
