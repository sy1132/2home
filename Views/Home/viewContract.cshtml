@model _2home.ViewModels.room

@{
    ViewBag.Title = "viewContract";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-center my-4">Chi Tiết Hợp Đồng Phòng</h2>
@if (TempData["Message"] != null) 
{
    <div class="alert alert-success">
        @TempData["Message"]
    </div>
}

<div class="container">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h4>Thông Tin Hợp Đồng</h4>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">Tên Motel:</dt>
                <dd class="col-sm-8">@Model.motelname</dd>

                <dt class="col-sm-4">Tên người thuê:</dt>
                <dd class="col-sm-8">@Model.fullname</dd>

                <dt class="col-sm-4">Ngày bắt đầu:</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Date_of_Issue)</dd>

                <dt class="col-sm-4">Tình trạng phòng:</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Room_Status)</dd>

                <dt class="col-sm-4">Tiền thuê:</dt>
                <dd class="col-sm-8">@Html.DisplayFor(model => model.Room_Rent)</dd>

                <dt class="col-sm-4">Thời gian hết hạn của hợp đồng:</dt>
                <dd class="col-sm-8">@Model.ContractEndDate</dd>

                <dt class="col-sm-4">Thời gian còn lại:</dt>
                <dd class="col-sm-8">@Model.RemainingTime ngày</dd>

                <dt class="col-sm-4">Tiền cọc:</dt>
                <dd class="col-sm-8">@String.Format("{0:N0} VNĐ", Model.Deposit ?? 0)</dd>
            </dl>

            <div class="text-center mt-4">
                <form action="@Url.Action("CancelContract", "Home")" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn hủy hợp đồng này không?');">
                    @Html.Hidden("Room_ID", Model.Room_ID)
                    <button type="submit" class="btn btn-danger">Hủy Hợp Đồng</button>
                </form>
            </div>
            <div class="text-center mt-4">

                @if (Model.RemainingTime.HasValue && Model.RemainingTime.Value <= 0)
                {
                    <form action="@Url.Action("CreateNewContract", "Home")" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn làm mới hợp đồng này không?');">
                        @Html.Hidden("Room_ID", Model.Room_ID)
                        <button type="submit" class="btn btn-danger">Làm mới hợp Đồng</button>
                    </form>
                }
            </div>
        </div>

    </div>
</div>
