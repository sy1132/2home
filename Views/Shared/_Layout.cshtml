    <style>

        .nav-link-custom {
            font-weight: bold;
        }

        .dropdown-menu {
            z-index: 1050;
        }
        .pagination-container {
            display: flex;
            justify-content: center;
            margin: 20px 0;
            padding: 10px;
        }

            .pagination-container a,
            .pagination-container span {
                padding: 10px 15px;
                margin: 0 5px;
                text-decoration: none;
                color: #000000;
                background-color: #ffffff; 
                border-radius: 5px;
                border: 1px solid #007bff;
                transition: background-color 0.3s, transform 0.3s;
                font-weight: bold;
            }

                .pagination-container a:hover {
                    background-color: #f0f0f0; 
                    transform: scale(1.05);
                }

            .pagination-container .current {
                background-color: #007bff; 
                color: #ffffff;
                border: none;
            }
        .container-fluid {
            position: relative;
        }

            .container-fluid::before {
                content: "";
                position: absolute;
                width: 100%;
                height: 100%;
                background-color: #ffffff;
                left: 0; 
                z-index: -1;
                transform: skewY(-5deg);
            }
        .bg-half-dark {
            background: linear-gradient(135deg, #0a1a33 30%, #ffffff 30%);
        }
        .text-black {
            color: #000000; 
            font-size: 1.25rem; 
        }

        .nav-link {
            color: #000000; 
        }

            .text-black:hover {
                color: #ff6600; 
            }
        .nav-link {
            color: #000000; 
        }

            .nav-link:hover {
                color: #ff6600; 
            }
      
        .slide__text {
            position: absolute;
            top: 30%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            opacity: 1;
            transition: all 0.7s;
            z-index: 3;
        }
    </style>
</head>

