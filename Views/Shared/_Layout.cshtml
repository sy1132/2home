                                    <input name="minPrice" type="range" id="minPrice" min="1000000" max="30000000" step="100000" value="1000000" oninput="updatePriceRangeDisplay()" class="custom-range">
                                    <input name="maxPrice" type="range" id="maxPrice" min="1000000" max="30000000" step="100000" value="30000000" oninput="updatePriceRangeDisplay()" class="custom-range">

