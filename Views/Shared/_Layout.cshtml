    <div class="position-relative text-center">

        <div class="d-flex justify-content-center " transform: translateX(-50%); width: 100%;">
            <div class="card-header" style="background-color: white; margin: 0; padding: 3; border-radius: 0.3rem; display: flex; flex-direction: column; width: 90%; box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.3);">
