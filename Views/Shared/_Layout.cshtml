<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Second Home</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="~/asset/css/layout.css" rel="stylesheet" />
    <style>
        .nav-link-custom {
            font-weight: bold;
        }

        .dropdown-menu {
            z-index: 1050;
        }
    </style>
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark w-100">
        <div class="container-fluid">
            <a href="@Url.Action("Index", "Home")" class="navbar-brand">
                <img src="~/Content/logo 2 home ngang.png" alt="Alternate Text" class="rounded-2" style="width:100px;">
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav ms-auto d-flex align-items-center">
                    @if (Session["User"] != null)
                    {
                        var user = Session["User"] as _2home.ViewModels.User;
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white mx-2" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Xin chào, @user.fullname
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="navbarDropdown">
                                @if (user.userrole == "Admin")
                                    
                                {
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("Manager_DK", "Home")">
                                            <i class="fas fa-user-cog"></i> Quản lý tài khoản
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("Kiemduyet", "Home")">
                                            <i class="fas fa-clipboard-list"></i> Kiểm duyệt
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("rental_management", "Home")">
                                            <i class="fas fa-home"></i> Quản lý thuê
                                        </a>
                                    </li>
                                    <video controls="controls">
                                        <source src="~/asset/videos/video.mp4" type="video/mp4" />
                                    </video>
                                }
                                else if (user.userrole == "Innkeeper")
                                {

                                    <li>
                                        <a class="dropdown-item text-bg-success" href="@Url.Action("loaded", "Home", new { ID_user = user.ID_user, ID_room = 1, amount = 100000 })">
                                            <i class="fas fa-wallet"></i> Số dư: <span id="user-balance">@user.blance</span> VND
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("QL_room", "Home")">
                                            <i class="fas fa-clipboard-list"></i> QL_phòng
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("DKthue", "Home")">
                                            <i class="fas fa-clipboard-list"></i> Đăng ký thuê
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li>
                                        <a class="dropdown-item text-bg-success" href="@Url.Action("TopUp", "Home", new { ID_user = user.ID_user, ID_room = 1, amount = 100000 })">
                                            <i class="fas fa-wallet"></i> Số dư: <span id="user-balance">@user.blance</span> VND
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("DKthue", "Home")">
                                            <i class="fas fa-clipboard-list"></i> Đăng ký thuê
                                        </a>
                                    </li>

                                    <li>
                                        @if (user.MotelID == null)
                                        {
                                            <a class="dropdown-item" href="@Url.Action("JoinRental", "Home")">
                                                <i class="fas fa-user-plus"></i> Tham gia trọ
                                            </a>
                                        }
                                        else
                                        {
                                            <a class="dropdown-item" href="@Url.Action("rent_check", "Home")">
                                                <i class="fas fa-clipboard-list"></i> Xem tiền trọ
                                            </a>
                                            <a class="dropdown-item" href="@Url.Action("viewContract", "Home")">
                                                <i class="fas fa-user-plus"></i> Xem thời hạn hợp đồng
                                            </a>
                                        }
                                    </li>

                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("togher", "Home")">
                                            <i class="fas fa-users"></i> Togher
                                        </a>
                                    </li>
                                }
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("mail", "Home")">
                                        <i class="fas fa-home"></i> Thư
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("Profile_user", "Home", new { ID_user = user.ID_user })">
                                        <i class="fas fa-user"></i> Profile
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="#">
                                        <i class="fas fa-cog"></i> Settings
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" href="/Home/Logout">
                                        <i class="fas fa-sign-out-alt"></i> Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            @Html.ActionLink("Đăng ký", "DK", "Home", null, new { @class = "btn btn-outline-danger mx-2 nav-link-custom" })
                        </li>
                        <li class="nav-item">
                            @Html.ActionLink("Đăng nhập", "Login", "Home", null, new { @class = "btn btn-outline-primary mx-2 nav-link-custom" })
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="d-flex justify-content-center">
        <div class="card-header bg-warning gap-2 m-3 p-3 rounded-3 d-flex flex-column w-50">
            <form class="d-flex flex-column mb-3" role="search" method="get" action="@Url.Action("Index")">
                <button type="button" class="btn btn-success border-2 mb-2" style="font-weight: bold;" onclick="toggleSearch()">
                    Tìm kiếm
                </button>

                <div id="search-container" class="search-container" style="display: none;">
                    <div class="d-flex mb-2">
                        <input class="form-control me-1 flex-grow-1" type="search" placeholder="Search" aria-label="Search" name="searchString" value="@ViewBag.Keyword">
                        <button type="submit" class="btn btn-outline-primary border-2" style="font-weight: bold;">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>

                    <div class="d-flex justify-content-start">
                        <fieldset class="me-2">
                            <select class="rounded-2 p-2" style="font-weight: bold;" id="inputCity" name="City">
                                <option selected value="">Chọn thành phố...</option>
                                <option value="Dĩ An">Dĩ An</option>
                                <option value="Thuận An">Thuận An</option>
                                <option value="Thủ Dầu Một">Thủ Dầu Một</option>
                                <option value="Tân Uyên">Tân Uyên</option>
                                <option value="Bến Cát">Bến Cát</option>
                            </select>
                        </fieldset>

                        <fieldset class="me-2">
                            <select class="rounded-2 p-2" style="font-weight: bold;" id="inputWard" name="Ward" disabled>
                                <option selected value="">Chọn phường...</option>
                            </select>
                        </fieldset>

                        <fieldset>
                            <select class="rounded-2 p-2" style="font-weight: bold;" id="inputDistrict" name="District" disabled>
                                <option selected value="">Chọn khu...</option>
                            </select>
                        </fieldset>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="d-flex flex-column justify-content-center align-items-center">
        @RenderBody()
        <hr />
    </div>
    <footer class="bg-dark text-white py-3 " style="margin-top: 9%;">
        <div class="container">
            <div class="row justify-content-between w-100">
                <!-- CSKH Section -->
                <div class="col-md-3 mb-3 text-center">
                    <h6 class="text-uppercase">CSKH</h6>
                    <ul class="list-unstyled small">
                        <li><i class="fas fa-phone"></i> Hotline: 123-456-789</li>
                        <li><i class="fas fa-envelope"></i> Email: support@secondhome.com</li>
                    </ul>
                </div>

                <!-- Contact Section -->
                <div class="col-md-3 mb-3 text-center">
                    <h6 class="text-uppercase">Liên lạc với chúng tôi</h6>
                    <ul class="list-unstyled small">
                        <li><i class="fas fa-map-marker-alt"></i> Địa chỉ: 123 Đường ABC, Quận XYZ, TP.HCM</li>
                        <li><i class="fas fa-phone"></i> Điện thoại: 987-654-321</li>
                    </ul>
                </div>

                <!-- Team Section -->
                <div class="col-md-3 mb-3 text-center">
                    <h6 class="text-uppercase">Người làm</h6>
                    <ul class="list-unstyled small">
                        <li><i class="fas fa-user"></i> Nguyễn Văn A</li>
                        <li><i class="fas fa-user"></i> Trần Thị B</li>
                        <li><i class="fas fa-user"></i> Lê Văn C</li>
                    </ul>
                </div>
            </div>

            <!-- Social Icons Section -->
            <div class="row">
                <div class="col-12 text-center">
                    <ul class="list-inline w-100" >
                        <li class="list-inline-item">
                            <a href="#" class="text-white"><i class="fab fa-facebook fa-lg"></i></a>
                        </li>
                        <li class="list-inline-item">
                            <a href="#" class="text-white"><i class="fab fa-twitter fa-lg"></i></a>
                        </li>
                        <li class="list-inline-item">
                            <a href="#" class="text-white"><i class="fab fa-instagram fa-lg"></i></a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <hr class="bg-light">
        <p class="text-center small mb-0">&copy; 2024 - Phòng chuyên môn Devmaster. All rights reserved.</p>
    </footer>

</body>
</html>
<style>
    
    .search-container {
        transition: width 0.5s ease;
        width: 0;
        overflow: hidden;
    }

        .search-container.active {
            width: 100%;
        }

    .nav-link-custom {
        font-weight: bold;
        transition: color 0.3s ease;
    }

        .nav-link-custom:hover {
            color: #ffcc00; /* Example hover color */
        }
</style>

<script>
    const data1 = {
        "Dĩ An": {
            wards: {
                "An Bình": ["Bình Đường 1", "Bình Đường 2", "Bình Đường 3", "Bình Đường 4"],
                "Bình An": ["Bình Thung 1", "Bình Thung 2", "Nội Hóa 1", "Nội Hóa 2", "Châu Thới"],
            }
        },
        "Thuận An": {
            wards: {
                "An Phú": ["1A", "1B", "2", "3", "4"],
            }
        },
        "Thủ Dầu Một": {
            wards: {
                "Chánh Mỹ": ["Chánh Lộc 1", "Chánh Lộc 2"],
            }
        },
        "Tân Uyên": {
            wards: {
                "Hội Nghĩa": ["1", "2", "3", "4"],
            }
        },
        "Bến Cát": {
            wards: {
                "An Điền": ["An Mỹ", "An Sơn"],
            }
        }
    };

    document.getElementById('inputCity').addEventListener('change', function () {
        const city = this.value;
        const wardSelect = document.getElementById('inputWard');
        const districtSelect = document.getElementById('inputDistrict');

        // Reset ward and district selections
        wardSelect.innerHTML = '<option value="">Chọn phường</option>';
        districtSelect.innerHTML = '<option value="">Chọn khu</option>';
        wardSelect.disabled = true;
        districtSelect.disabled = true;

        if (city && data1[city]) {
            const wards = data1[city].wards;
            wardSelect.disabled = false;

            for (const ward in wards) {
                const option = document.createElement('option');
                option.value = ward;
                option.textContent = ward;
                wardSelect.add(option);
            }
        }
    });

    document.getElementById('inputWard').addEventListener('change', function () {
        const city = document.getElementById('inputCity').value;
        const ward = this.value;
        const districtSelect = document.getElementById('inputDistrict');

        districtSelect.innerHTML = '<option value="">Chọn khu</option>';
        districtSelect.disabled = true;

        if (city && ward && data1[city].wards[ward]) {
            const neighborhoods = data1[city].wards[ward];
            districtSelect.disabled = false;

            neighborhoods.forEach(function (neighborhood) {
                const option = document.createElement('option');
                option.value = neighborhood;
                option.textContent = neighborhood;
                districtSelect.add(option);
            });
        }
    });

    function toggleSearch() {
        var searchContainer = document.getElementById("search-container");
        if (searchContainer.style.display === "none") {
            searchContainer.style.display = "block";
            setTimeout(function () {
                searchContainer.classList.add("active");
            }, 10);
        } else {
            searchContainer.classList.remove("active");
            setTimeout(function () {
                searchContainer.style.display = "none";
            }, 500);
        }
    }
</script>