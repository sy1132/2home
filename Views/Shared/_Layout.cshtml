                                    <option value="Dĩ An">Dĩ An</option>
                                    <option value="Thuận An">Thuận An</option>
                                    <option value="Thủ Dầu Một">Thủ Dầu Một</option>
                                    <option value="Tân Uyên">Tân Uyên</option>
                                    <option value="Bến Cát">Bến Cát</option>
                                </select>
                            </fieldset>

                            <fieldset class="me-2">
                                <select class="rounded-2 p-2" style="font-weight: bold; font-size: 1.2rem; background-color: white; border: 2px solid black;" id="inputWard" name="Ward" disabled>
                                    <option selected value="">Chọn phường...</option>
                                </select>
                            </fieldset>

                            <fieldset>
                                <select class="rounded-2 p-2" style="font-weight: bold; font-size: 1.2rem; background-color: white; border: 2px solid black;" id="inputDistrict" name="District" disabled>
                                    <option selected value="">Chọn khu...</option>
                                </select>
                            </fieldset>
                            <div class="d-flex align-items-center ms-4">
                                <label style="font-weight: bold; font-size: 1.2rem; margin-right: 15px; white-space: nowrap;">Khoảng giá (VNĐ):</label>

                               
                                <span id="priceRangeDisplay" style="font-size: 1.2rem; font-weight: bold; margin-right: 15px;">1,000,000 - 30,000,000</span>

