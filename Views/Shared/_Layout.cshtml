<style>
 
    .custom-footer p {
        margin: 0;
        padding-top: 10px;
    }


    .custom-footer p {
        margin: 0;
        padding-top: 10px;
    }

    .search-container {
        transition: width 0.5s ease;
        width: 0;
        overflow: hidden;
    }

        .search-container.active {
            width: 100%;
        }

    .nav-link-custom {
        font-weight: bold;
        transition: color 0.3s ease;
    }

        .nav-link-custom:hover {
            color: #ffcc00;
        }
    .btn-outline-danger {
        color: #dc3545;
        border-color: #dc3545;
    }

        .btn-outline-danger:hover {
            color: #fff;
            background-color: #dc3545;
            border-color: #dc3545;
        }

    .btn-outline-primary {
        color: #007bff;
        border-color: #007bff;
    }

        .btn-outline-primary:hover {
            color: #fff;
            background-color: #007bff;
            border-color: #007bff;
        }
    .custom-range {
        -webkit-appearance: none;
        width: 100%;
        height: 8px;
        background: #ddd;
        outline: none;
        padding: 0;
        margin: 0;
    }

        .custom-range::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 20px;
            height: 20px;
            background-color: #007bff;
            border: 2px solid #ffffff;
            border-radius: 50%;
            cursor: pointer;
            box-shadow: 0px 0px 5px rgba(0, 0, 0, 0.3);
            transition: background-color 0.3s ease;
        }

            .custom-range::-webkit-slider-thumb:hover {
                background-color: #0056b3;
            }

        .custom-range::-moz-range-thumb {
            width: 20px;
            height: 20px;
            background-color: #007bff;
            border: 2px solid #ffffff;
            border-radius: 50%;
            cursor: pointer;
            box-shadow: 0px 0px 5px rgba(0, 0, 0, 0.3);
            transition: background-color 0.3s ease;
        }

            .custom-range::-moz-range-thumb:hover {
                background-color: #0056b3;
            }

        .custom-range::-ms-thumb {
            width: 20px;
            height: 20px;
            background-color: #007bff;
            border: 2px solid #ffffff;
            border-radius: 50%;
            cursor: pointer;
            box-shadow: 0px 0px 5px rgba(0, 0, 0, 0.3);
            transition: background-color 0.3s ease;
        }

            .custom-range::-ms-thumb:hover {
                background-color: #0056b3;
            }
</style>

<script>

        const data1 = {
            "Dĩ An": {
                wards: {
                    "An Bình": ["Bình Đường 1", "Bình Đường 2", "Bình Đường 3", "Bình Đường 4"],
                    "Bình An": ["Bình Thung 1", "Bình Thung 2", "Nội Hóa 1", "Nội Hóa 2", "Châu Thới"],
                }
            },
            "Thuận An": {
                wards: {
                    "An Phú": ["1A", "1B", "2", "3", "4"],
                }
            },
            "Thủ Dầu Một": {
                wards: {
                    "Chánh Mỹ": ["Chánh Lộc 1", "Chánh Lộc 2"],
                }
            },
            "Tân Uyên": {
                wards: {
                    "Hội Nghĩa": ["1", "2", "3", "4"],
                }
            },
            "Bến Cát": {
                wards: {
                    "An Điền": ["An Mỹ", "An Sơn"],
                }
            }
        };

        document.getElementById('inputCity').addEventListener('change', function () {
            const city = this.value;
            const wardSelect = document.getElementById('inputWard');
            const districtSelect = document.getElementById('inputDistrict');

            wardSelect.innerHTML = '<option value="">Chọn phường</option>';
            districtSelect.innerHTML = '<option value="">Chọn khu</option>';
            wardSelect.disabled = true;
            districtSelect.disabled = true;

            if (city && data1[city]) {
                const wards = data1[city].wards;
                wardSelect.disabled = false;

                for (const ward in wards) {
                    const option = document.createElement('option');
                    option.value = ward;
                    option.textContent = ward;
                    wardSelect.add(option);
                }
            }
        });

        document.getElementById('inputWard').addEventListener('change', function () {
            const city = document.getElementById('inputCity').value;
            const ward = this.value;
            const districtSelect = document.getElementById('inputDistrict');

            districtSelect.innerHTML = '<option value="">Chọn khu</option>';
            districtSelect.disabled = true;

            if (city && ward && data1[city].wards[ward]) {
                const neighborhoods = data1[city].wards[ward];
                districtSelect.disabled = false;

                neighborhoods.forEach(function (neighborhood) {
                    const option = document.createElement('option');
                    option.value = neighborhood;
                    option.textContent = neighborhood;
                    districtSelect.add(option);
                });
            }
        });

        function toggleSearch() {
            var searchContainer = document.getElementById("search-container");
            if (searchContainer.style.display === "none") {
                searchContainer.style.display = "block";
                setTimeout(function () {
                    searchContainer.classList.add("active");
                }, 10);
            } else {
                searchContainer.classList.remove("active");
                setTimeout(function () {
                    searchContainer.style.display = "none";
                }, 500);
            }
        }
        const minPriceInput = document.getElementById("minPrice");
        const maxPriceInput = document.getElementById("maxPrice");
        const priceRangeDisplay = document.getElementById("priceRangeDisplay");

        function updatePriceRangeDisplay() {
            let minPrice = parseInt(minPriceInput.value);
            let maxPrice = parseInt(maxPriceInput.value);

            if (minPrice >= maxPrice - 100000) {
                minPriceInput.value = maxPrice - 100000;
                minPrice = maxPrice - 100000;
            }
            if (maxPrice <= minPrice + 100000) {
                maxPriceInput.value = minPrice + 100000;
                maxPrice = minPrice + 100000;
            }
            priceRangeDisplay.innerText = `${minPrice.toLocaleString()} - ${maxPrice.toLocaleString()}`;
        }

        minPriceInput.addEventListener("input", updatePriceRangeDisplay);
        maxPriceInput.addEventListener("input", updatePriceRangeDisplay);

        updatePriceRangeDisplay();

</script>