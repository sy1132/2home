                    <option value="1">Bình chuẩn</option>
                    <option value="2">Thành phố mới</option>
                    <option value="3">Thủ dầu một</option>
                </select>
            </fieldset>
        </form>
        <form action="/Home/LocationChosen" method="get">

            <fieldset>
                Vị trí <select id="location" name="Vị trí">
                    <option selected="selected" value="0">Tất cả</option>
                    <option value="1">Bình chuẩn</option>
                    <option value="2">Thành phố mới</option>
                    <option value="3">Thủ dầu một</option>
                </select>
            </fieldset>
        </form>
        <form action="/Home/LocationChosen" method="get">

            <fieldset>
                Vị trí <select id="location" name="Vị trí">
                    <option selected="selected" value="0">Tất cả</option>
                    <option value="1">Bình chuẩn</option>
                    <option value="2">Thành phố mới</option>
                    <option value="3">Thủ dầu một</option>
                </select>
            </fieldset>

        </form>
        <p><input type="submit" value="tìm kiếm" /> </p>
    </div>
    <div>

        @RenderBody()

        <hr />

        <footer>

            <p>&copy; @DateTime.Now.Year - Phòng chuyên môn Devmaster</p>

        </footer>



